fn main2() {
	let x;
	for (let y = 0; y < HEIGHT; y = y + 1) {
		for (x = 0; x < WIDTH; x = x + 1) {
			write_pixel(x, y, BLUE);
		}
	}
	write_into_framebuffer();
}

fn main() {
	(1 + HEIGHT * WIDTH * HEIGHT);
}
