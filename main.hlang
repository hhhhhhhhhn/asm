extern dumplen
extern syscall4
extern printu
extern prints
extern newline

let WIDTH = 400
let HEIGHT = 200
let FB_WIDTH = 1920
let FB_HEIGHT = 1080
space buffer 320000 # 4 bytes * 100 HEIGHT * 200 WIDTH
space black_buffer 10000
let buffer_len = 320000
let MAGENTA = 0xff00ff00
let SKY  =   0xff55aa00
let SKY2 =   0x3333aa00
let BLUE =   0x0000ff00
let DBLUE1 = 0x0000dd00
let DBLUE2 = 0x0000cc00
let DBLUE3 = 0x0000bb00
let DBLUE4 = 0x0000aa00
let LBLUE1 = 0x5555ff00
let LBLUE2 = 0xaaaaff00
let GREEN =  0x00ff0000
let DGREEN = 0x00990000
let BLACK =  0x00000000
let SAND =   0xffff6600
let SUN =    0xffffaa00
let CLOUDS = 0xffffaa00
let SANDSHADOW = 0xcccc3300

fn low_byte(x) {
	return band(x, 0xff);
}

fn write_pixel(x, y, color) {
	let location = &buffer + 4*(y*WIDTH + x);
	if not(location > &buffer and location + 4 < &buffer + buffer_len) {
		return 0
	}

	set_byte(location+0, low_byte(rshift(color, 1*8)));
	set_byte(location+1, low_byte(rshift(color, 2*8)));
	set_byte(location+2, low_byte(rshift(color, 3*8)));
	set_byte(location+3, low_byte(rshift(color, 0*8)));
}

fn read_pixel(x, y) {
	let location = &buffer + 4*(y*WIDTH + x);

	let a = get_byte(location+0);
	let b = get_byte(location+1);
	let g = get_byte(location+2);
	let r = get_byte(location+3);

	return lshift(r, 3*8) + lshift(g,2*8) + lshift(b,8) + a
}

# TODO: Optimize
fn write_into_framebuffer() {
	let framebuffer_fd = open_for_writing("/dev/fb0");
	let location;
	let row_location;
	let y;
	for (y = 0; y < FB_HEIGHT; y = y + 1) {
		if (y < HEIGHT) {
			row_location = &buffer + 4*y*WIDTH;
			syscall4(
				1,              # write
				framebuffer_fd, # stdout
				row_location,   # buffer
				4*WIDTH         # buffer_len
			);
			syscall4(
				1,                     # write
				framebuffer_fd,        # stdout
				&black_buffer,         # buffer
				4*(FB_WIDTH - WIDTH)   # buffer_len
			);
		} else {
			syscall4(
				1,                     # write
				framebuffer_fd,        # stdout
				&black_buffer,         # buffer
				4*FB_WIDTH             # buffer_len
			);
		}
	}
	close(framebuffer_fd);
}

space timespec 16

fn open_for_writing(filename) {
	return syscall4(
		2,    # open
		filename,
		577,  # O_WRONLY | O_CREAT | O_TRUNC
		0770 # Mode
	)
}

fn close(fd) {
	syscall4(
		3,  #close
		fd,
		0,  #padding
		0
	)
}

fn sleep(miliseconds) {
	set(&timespec, miliseconds/1000);                 #seconds
	set(&timespec+8, 1_000_000 * (miliseconds%1000)); #nanoseconds
	syscall4(35, &timespec, 0, 0);
}

fn draw_rectangle(x1, y1, x2, y2, color) {
	for(let y = y1; y < y2; y = y+1) {
		for(let x = x1; x < x2; x = x+1) {
			write_pixel(x, y, color);
		}
	}
}

fn draw_circle(x0, y0, r, color) {
	for (let y = y0 - r; y < y0 + r; y = y + 1) {
		for (let x = x0 - r; x < x0 + r; x = x + 1) {
			if (x-x0)*(x-x0)+(y-y0)*(y-y0) <= r*r {
				write_pixel(x,y,color);
			}
		}
	}
}

fn draw_circle_above(x0, y0, r, cutoff, color) {
	for (let y = y0 - r; y < cutoff; y = y + 1) {
		for (let x = x0 - r; x < x0 + r; x = x + 1) {
			if (x-x0)*(x-x0)+(y-y0)*(y-y0) <= r*r {
				write_pixel(x,y,color);
			}
		}
	}
}

fn swap(a, b) {
	let temp = *a;
	set(a, *b);
	set(b, temp);
}

fn absolute_value(x) {
	if x < 0 {
		return -x;
	}
	return x;
}

fn triangle_wave(x) {
	return absolute_value((x % 100) - 50);
}

# Values from -100 to 100, with period 200
fn wierd_wave(x) {
	return (triangle_wave(x)
		+ triangle_wave(x + 10)
		+ triangle_wave(x + 20)
		+ triangle_wave(x + 30)
		+ triangle_wave(x + 40)
		+ triangle_wave(x + 50) - 90) * 5/3 - 50
}

fn draw_sine(height, color) {
	for(let x = 0; x < WIDTH; x = x+1) {
		let y_max = (height*40 + wierd_wave(x*2))/40
		for (let y = 0; y < y_max; y = y+1) {
			write_pixel(x, y, color);
		}
	}
}

fn draw_line(x1, y1, x2, y2, color) {
	if (x2 < x1) {
		draw_line(x2, y2, x1, y1, color);
		return 0;
	} elseif (x2 == x1){
		if (y2 < y1) {
			swap(&y1, &y2);
		}
		for (let y = y1; y <= y2; y = y + 1) {
			write_pixel(x1, y, color);
		}
		return 0;
	}
	let last_y = y1;
	for(let x = x1; x <= x2; x = x + 1) {
		let new_y = (y2 - y1)*(x - x1)/(x2 - x1) + y1;
		let ymin = min2(last_y, new_y);
		let ymax = max2(last_y, new_y);
		for(let y = ymin; y <= ymax; y = y + 1) {
			write_pixel(x, y, color);
		}
		last_y = new_y;
	}
}

fn draw_bird(x, y) {
	draw_line(x,   y+3, x+3,  y,   BLACK);
	draw_line(x+3, y,   x+6,  y+3, BLACK);
	draw_line(x+6, y+3, x+9,  y,   BLACK);
	draw_line(x+9, y,   x+12, y+3, BLACK);
}

fn triangle_area(x1, y1, x2, y2, x3, y3) {
	return absolute_value(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2)) # /2 not necessary
}

fn is_inside_triangle(x, y, x1, y1, x2, y2, x3, y3) {
	let area  = triangle_area(x1, y1, x2, y2, x3, y3);
	let area1 = triangle_area(x,  y,  x2, y2, x3, y3);
	let area2 = triangle_area(x1, y1, x,  y,  x3, y3);
	let area3 = triangle_area(x1, y1, x2, y2, x,  y );

	return area > area1 + area2 + area3 - 3 and area < area1 + area2 + area3 + 3;
}

fn min3(x, y, z) {
	let min = x;
	if (y < min) {
		min = y;
	}
	if (z < min) {
		min = z;
	}
	return min
}

fn max3(x, y, z) {
	let max = x;
	if (y > max) {
		max = y;
	}
	if (z > max) {
		max = z;
	}
	return max
}

fn draw_triangle(x1, y1, x2, y2, x3, y3, color) {
	let x_min = min3(x1, x2, x3);
	let x_max = max3(x1, x2, x3);
	let y_min = min3(y1, y2, y3);
	let y_max = max3(y1, y2, y3);

	for (let y = y_min; y <= y_max; y = y + 1) {
		for (let x = x_min; x <= x_max; x = x + 1) {
			if (is_inside_triangle(x, y, x1, y1, x2, y2, x3, y3)) {
				write_pixel(x, y, color);
			}
		}
	}
}

space vertices 512
let vertices_len = 0

fn vx(index) {
	return *(&vertices + 16*(index % vertices_len));
}

fn vy(index) {
	return *(&vertices + 16*(index % vertices_len)+8);
}

fn remove_vertex(index) {
	let index = index % vertices_len;
	for(let i = index+1; i < vertices_len; i = i + 1) {
		set(&vertices + 16*(i - 1),     *(&vertices + 16*i    ));
		set(&vertices + 16*(i - 1) + 8, *(&vertices + 16*i + 8));
	}
	vertices_len = vertices_len - 1;
}

space vertices_copy 512
fn draw_polygon_with_border(color, bordercolor) {
	let vertices_len_copy = vertices_len;
	for(let i = 0; i < vertices_len; i = i + 1) {
		set(&vertices_copy + 16*i,     *(&vertices + 16*i    ));
		set(&vertices_copy + 16*i + 8, *(&vertices + 16*i + 8));
	}
	draw_polygon(color);
	vertices_len = vertices_len_copy
	for(let i = 0; i < vertices_len; i = i + 1) {
		set(&vertices + 16*i,     *(&vertices_copy + 16*i    ));
		set(&vertices + 16*i + 8, *(&vertices_copy + 16*i + 8));
	}
	for(let i = 0; i < vertices_len - 1; i = i + 1) {
		draw_line(vx(i), vy(i), vx(i + 1), vy(i + 1), bordercolor);
	}
	draw_line(vx(0), vy(0), vx(vertices_len - 1), vy(vertices_len - 1), bordercolor);
	vertices_len = 0;
}

fn draw_polygon(color) {
	while (vertices_len >= 3) {
		if vertices_len == 3 {
			draw_triangle(vx(0), vy(0), vx(1), vy(1), vx(2), vy(2), color)
			vertices_len = 0
			return 0
		}
		for (let i = 0; i < vertices_len; i = i + 1) {
			let is_ear = true
			for (let j = 0; j < vertices_len; j = j + 1) {
				if (j % vertices_len) == (i % vertices_len)
					or (j % vertices_len) == ((i+1) % vertices_len)
					or (j % vertices_len) == ((i+2) % vertices_len) {
						continue
				}
				if is_inside_triangle(vx(j), vy(j), vx(i), vy(i), vx(i+1), vy(i+1), vx(i+2), vy(i+2)) {
					is_ear = false
					break
				}
			}
			if is_ear {
				draw_triangle(vx(i), vy(i), vx(i+1), vy(i+1), vx(i+2), vy(i+2), color)
				remove_vertex(i+1);
				break
			}
		}
	}
}

fn push_vertex(x, y) {
	set(&vertices + vertices_len*16, x);
	set(&vertices + vertices_len*16 + 8, y);
	vertices_len = vertices_len + 1;
}

fn max2(a, b) {
	if a > b {
		return a
	}
	return b
}
fn min2(a, b) {
	if a < b {
		return a
	}
	return b
}

fn frame(t) {
	let t = t*2
	for (let y = 0; y < HEIGHT; y = y + 1) {
		for (let x = 0; x < WIDTH; x = x + 1) {
			write_pixel(x, y, SAND);
		};
	}

	# Waves
	draw_sine(wierd_wave((t+000)/10)/10 + 70 + 50, LBLUE2);
	draw_sine(wierd_wave((t+070)/10)/10 + 70 + 45, LBLUE1);
	draw_sine(wierd_wave((t+140)/10)/10 + 70 + 40, BLUE);
	draw_sine(wierd_wave((t+210)/10)/10 + 70 + 35, DBLUE1);
	draw_sine(wierd_wave((t+280)/10)/10 + 70 + 30, DBLUE2);
	draw_sine(wierd_wave((t+350)/10)/10 + 70 + 25, DBLUE3);
	draw_sine(wierd_wave((t+420)/10)/10 + 70 + 20, DBLUE4);

	# Sky
	draw_rectangle(0, 0, 400, 60, SKY);
	draw_rectangle(0, 60, 400, 62, SKY2);

	# Sun
	draw_circle_above(200, (t/200 % 200) - 40, 40, 60, SUN);

	# Birds
	draw_bird(t/20 - 10, 10 + wierd_wave(t/20 + 10)/20);
	draw_bird(t/20 - 30, 10 + wierd_wave(t/20 + 30)/20);
	draw_bird(t/20 - 50, 10 + wierd_wave(t/20 + 80)/20);

	# Elephant shadow
	push_vertex( 71, 162);
	push_vertex( 88, 161);
	push_vertex( 74, 187);
	push_vertex( 47, 190);
	draw_polygon(SANDSHADOW);

	push_vertex(102, 183);
	push_vertex(120, 158);
	push_vertex(132, 158);
	push_vertex(121, 199);
	push_vertex(41,  199);
	push_vertex(49,  186);
	draw_polygon(SANDSHADOW);

	# Elephant Leg 1
	push_vertex( 79, 132);
	push_vertex( 82, 129);
	push_vertex( 89, 129);
	push_vertex( 93, 142);
	push_vertex( 88, 162);
	push_vertex( 87, 163);
	push_vertex( 82, 163);
	push_vertex( 81, 162);
	draw_polygon_with_border(DGREEN, BLACK);

	# Elephant Leg 4
	push_vertex(121, 130);
	push_vertex(124, 127);
	push_vertex(131, 127);
	push_vertex(135, 140);
	push_vertex(130, 160);
	push_vertex(129, 161);
	push_vertex(124, 161);
	push_vertex(123, 160);
	draw_polygon_with_border(DGREEN, BLACK);

	# Elephant Body
	push_vertex( 61, 158);
	push_vertex( 57, 158);
	push_vertex( 54, 131);
	push_vertex( 53, 130);
	push_vertex( 58, 116);
	push_vertex( 71, 107);
	push_vertex( 89, 112);
	push_vertex(125, 113);
	push_vertex(138, 131);
	push_vertex(136, 132);
	push_vertex(125, 118);
	push_vertex(130, 129);
	push_vertex(128, 136);
	push_vertex(122, 142);
	push_vertex( 95, 144);
	push_vertex( 72, 142);
	push_vertex( 68, 137);
	push_vertex( 68, 132);
	push_vertex( 63, 132);
	draw_polygon_with_border(DGREEN, BLACK);

	# Elephant Ear
	draw_line(70, 111, 79, 121, BLACK);
	draw_line(79, 121, 78, 127, BLACK);
	draw_line(78, 127, 72, 129, BLACK);

	# Elephant Horn
	push_vertex( 51, 126);
	push_vertex( 66, 127);
	push_vertex( 67, 132);
	draw_polygon_with_border(SUN, BLACK);

	# Elephant eye
	draw_circle( 63, 120, 2, BLACK);
	write_pixel( 63, 120, SUN);

	# Elephant Leg 3
	push_vertex( 69, 135);
	push_vertex( 72, 132);
	push_vertex( 79, 132);
	push_vertex( 83, 145);
	push_vertex( 78, 165);
	push_vertex( 77, 166);
	push_vertex( 72, 166);
	push_vertex( 71, 165);
	draw_polygon_with_border(DGREEN, BLACK);

	# Elephant Leg 4
	push_vertex(114, 135);
	push_vertex(117, 132);
	push_vertex(124, 132);
	push_vertex(128, 145);
	push_vertex(123, 165);
	push_vertex(122, 166);
	push_vertex(117, 166);
	push_vertex(116, 165);
	draw_polygon_with_border(DGREEN, BLACK);

}

fn main() {
	let t;
	let middle = 0;
	for(let t = 0; true; t = t + 1) {
		frame(t);
		write_into_framebuffer();
	}
}
