extern global_arena_allocator_start extern global_arena_allocator_end
extern malloc extern list_new extern list_push_new extern list_get extern list_destroy extern list_used
extern string_builder_new
extern string_builder_finish
extern string_builder_push
extern read_all_to_string
extern list_grow
extern strcpy

struct token
	type
	value
end

space tokens 8

# type: u64, value: void* -> void
fn push_token local type local value
	!value !type

	local token
	&tokens get list_push_new !token

	?token ?type  token_set_type
	?token ?value token_set_value
end

space input  8
space char_index  8
space char_length 8

fn NUMBER   10  end
fn STRING   11  end
fn IDENT    12  end
fn LPAREN   51  end # symbols > 50
fn RPAREN   52  end
fn LBRACK   53  end
fn RBRACK   54  end
fn PLUS     55  end
fn MINUS    56  end
fn SEMI     57  end
fn COMMA    58  end
fn EQ       59  end
fn LT       60  end
fn GT       61  end
fn EQEQ     62  end
fn NE       63  end
fn LE       64  end
fn GE       65  end
fn MULT     66  end
fn DIVIDE   67  end
fn MODULO   68  end
fn POINTER  69  end
fn DEREF    70  end
fn IF       101 end # keywords > 100
fn ELSEIF   102 end
fn ELSE     103 end
fn LOOP     104 end
fn FN       105 end
fn EXTRN    106 end
fn LET      107 end
fn RETURN   108 end
fn BREAK    109 end
fn CONTINUE 110 end
fn AND      111 end
fn OR       112 end
fn SPACE    113 end


fn NULL 0 end

# void -> char
fn peek_char
	&char_index get &char_length get ge if
		0 return
	end

	&input get
		&char_index get
			add
				get_byte
end

# void -> char, char
fn peek_2_chars
	peek_char
	advance_char peek_char

	&char_index
		&char_index get 1 sub
			set
end

# void -> void (changes index)
fn advance_char
	&char_index
		&char_index get 1 add
			set
end


# char -> bool
fn is_alpha local char
	!char

	?char 'a' ge
		?char 'z' le
			band
	?char 'A' ge
		?char 'Z' le
			band
				bor
end

# char -> bool
fn is_num local char
	!char

	?char '0' ge
		?char '9' le
			band
end

# char -> bool
fn is_whitespace local char
	!char

	?char 10 eq
		?char ' ' eq bor
			?char 9 eq bor
end

# void -> void
fn consume_whitespace
	loop
		peek_char is_whitespace not if
			break
		end
		advance_char
	end
end

# void -> void
fn consume_number
	local sign
	1 !sign

	peek_char '-' eq if
		-1 !sign
		advance_char
	end

	local num
	0 !num

	local char
	loop
		peek_char !char

		?char is_num if
			?num 10 mul !num
			?num
				?char '0' sub
					add !num
			advance_char
			continue
		end
		?char '_' eq if
			advance_char
			continue
		end
		break
	end

	?num ?sign mul
		!num

	NUMBER ?num push_token
end

# void -> void
fn consume_ident
	local builder
	string_builder_new !builder

	local char
	loop
		peek_char !char

		?char is_alpha ?char is_num bor ?char '_' eq bor if
			?builder ?char string_builder_push
			advance_char
			continue
		end
		break
	end

	local str
	?builder string_builder_finish !str

	?str "if" streq if
		IF ?str push_token
		return
	end
	?str "elseif" streq if
		ELSEIF ?str push_token
		return
	end
	?str "else" streq if
		ELSE ?str push_token
		return
	end
	?str "loop" streq if
		LOOP ?str push_token
		return
	end
	?str "fn" streq if
		FN ?str push_token
		return
	end
	?str "extern" streq if
		EXTRN ?str push_token
		return
	end
	?str "let" streq if
		LET ?str push_token
		return
	end
	?str "return" streq if
		RETURN ?str push_token
		return
	end
	?str "break" streq if
		BREAK ?str push_token
		return
	end
	?str "continue" streq if
		CONTINUE ?str push_token
		return
	end
	?str "and" streq if
		AND ?str push_token
		return
	end
	?str "or" streq if
		OR ?str push_token
		return
	end
	?str "space" streq if
		SPACE ?str push_token
		return
	end

	IDENT ?str push_token
end

# void -> void
fn consume_string
	local builder
	string_builder_new !builder

	advance_char # skip opening quote

	local char
	loop
		peek_char !char
		advance_char

		?char '"' eq if
			break
		end
		?char '\' eq if
			peek_char !char
			advance_char

			?char 'n' eq if
				10 !char
			end

			?char 't' eq if
				9 !char
			end

			?char '0' eq if
				0 !char
			end
		end
		?builder ?char string_builder_push
	end

	local str
	?builder string_builder_finish !str

	STRING ?str push_token
end

# void -> bool
fn consume_token
	consume_whitespace

	local char local next_char
	peek_2_chars !next_char !char

	?char is_alpha if
		consume_ident
		1 return
	end
	?char is_num if
		consume_number
		1 return
	end
	?char '-' eq
		?next_char is_num
			band if
				consume_number
				1 return
	end
	?char '"' eq if
		consume_string
		1 return
	end
	?char '(' eq if
		LPAREN '(' push_token
		advance_char
		1 return
	end
	?char ')' eq if
		RPAREN ')' push_token
		advance_char
		1 return
	end
	?char '{' eq if
		LBRACK '{' push_token
		advance_char
		1 return
	end
	?char '}' eq if
		RBRACK '}' push_token
		advance_char
		1 return
	end
	?char '+' eq if
		PLUS '+' push_token
		advance_char
		1 return
	end
	?char '-' eq if
		MINUS '-' push_token
		advance_char
		1 return
	end
	?char ';' eq if
		SEMI ';' push_token
		advance_char
		1 return
	end
	?char ',' eq if
		COMMA ',' push_token
		advance_char
		1 return
	end
	?char '*' eq if
		MULT '*' push_token
		advance_char
		1 return
	end
	?char '/' eq if
		DIVIDE '/' push_token
		advance_char
		1 return
	end
	?char '%' eq if
		MODULO '%' push_token
		advance_char
		1 return
	end
	?char '&' eq if
		POINTER '&' push_token
		advance_char
		1 return
	end
	?char '=' eq
		?next_char '=' eq 
			band if
				EQEQ 'e' push_token
				advance_char
				advance_char
				1 return
	end
	?char '=' eq if
		EQ '=' push_token
		advance_char
		1 return
	end
	?char '<' eq 
		?next_char '=' eq 
			band if
				LE 'l' push_token
				advance_char
				advance_char
				1 return
	end
	?char '>' eq 
		?next_char '=' eq 
			band if
				GE 'g' push_token
				advance_char
				advance_char
				1 return
	end
	?char '!' eq 
		?next_char '=' eq 
			band if
				NE 'n' push_token
				advance_char
				advance_char
				1 return
	end
	?char '<' eq if
		LT '<' push_token
		advance_char
		1 return
	end
	?char '>' eq if
		GT '>' push_token
		advance_char
		1 return
	end
	?char NULL eq if
		NULL return
	end

	# TODO: COMMENTS

	"TOKENIZER ERROR" panic
	newline
	0 return
end

# void -> void
fn consume_all_tokens
	loop
		consume_token not if
			break
		end
	end
end

# token* -> void
fn print_token local token
	!token

	?token token_get_type NUMBER eq if
		"TOKEN: NUMBER " prints
		?token token_get_value printi
		newline
		return
	end
	?token token_get_type STRING eq if
		"TOKEN: STRING '" prints
		?token token_get_value prints
		"'" prints
		newline
		return
	end
	?token token_get_type IDENT eq if
		"TOKEN: IDENT '" prints
		?token token_get_value prints
		"'" prints
		newline
		return
	end
	?token token_get_type 100 gt if
		"TOKEN: KEYWORD " prints
		?token token_get_value prints
		newline
		return
	end
	?token token_get_type 50 gt if
		"TOKEN: SYMBOL " prints
		?token token_get_value printc
		newline
		return
	end
	"TOKEN: UNKNOWN " prints newline
end

# void -> void
fn print_tokens
	local token
	local i
	0 !i

	local len
	&tokens get list_used !len

	"TOTAL TOKENS: " prints
	?len printu newline

	loop
		?i ?len ge if
			break
		end

		&tokens get ?i list_get !token
		?i 1 add !i

		?token print_token
	end
end

space token_index 8

# void -> token*
fn peek_token
	local index
	&token_index get !index

	&tokens get ?index list_get return
end

# void -> token*, token*
fn peek_2_tokens
	local index
	&token_index get !index

	&tokens get ?index       list_get
	&tokens get ?index 1 add list_get
end

# void -> bool
fn at_end_of_tokens
	local index
	local len

	&token_index get !index
	&tokens get list_used !len

	?index ?len ge return
end

# void -> void (advances token_index)
fn advance_token
	&token_index
		&token_index get 1 add
			set
end

# void -> void (writes output)
fn generate_header
	"section .text"               prints newline
	"global _start"               prints newline
	"global STACK"                prints newline
	"_start:"                     prints newline
	"lea rcx, [STACK+1024*8]"     prints newline  # Loads stack pointer to rcx (rcx will always be the stack pointer)
	"call main"                   prints newline
	"mov rax, 60"                 prints newline  # Exists with error code 0
	"mov rdi, 0"                  prints newline
	"syscall"                     prints newline
end

# char* -> void
fn panic
	"\033[1;31mPANIC: " prints
	prints newline
	"\033[0m" prints
	60 2 0 0 syscall
end

# void -> void (writes output)
fn generate_footer
	"section .bss"      prints newline
	"STACK resq 1024"   prints newline # Reserves the stack

	generate_string_table
end

# char* -> void (writes output)
fn generate_single_escaped_string local string
	!string

	"\"" prints
	local ith_char
	local i 0 !i
	loop
		?string ?i add get_byte !ith_char

		?ith_char NULL eq if
			break
		end
		?ith_char is_printable if
			?ith_char printc
		else
			"\", " prints
			?ith_char printu
			", \"" prints
		end

		?i 1 add !i
	end

	"\", 0" prints
end

# void -> void (writes output)
fn generate_string_table
	"section .data" prints newline

	local i 0 !i

	loop
		?i &strings_len get ge if
			break
		end

		"STRING" prints
		?i printu
		" db " prints

		&strings
			?i 1024 mul
				add
					generate_single_escaped_string

		newline

		?i 1 add !i
	end
end

# u64 (token_type) -> void (advances token_index)
fn expect_token local expected_type
	!expected_type

	peek_token token_get_type
		?expected_type
			ne if
				"Got " prints
				peek_token print_token
				"Expected type " prints
				?expected_type printu newline
				"SYNTAX ERROR: Unexpected token" panic
		end
	advance_token
end

# void -> void (advances token_index & generates output)
fn generate_program
	loop
		at_end_of_tokens if
			return
		end
		generate_global_statement
	end
end

# void -> void (advances token_index & generates output)
fn generate_global_statement
	peek_token token_get_type FN eq if
		generate_function
		return
	end
	peek_token token_get_type LET eq if
		generate_global_variable
		return
	end
	peek_token token_get_type SPACE eq if
		generate_space
		return
	end
	peek_token token_get_type EXTRN eq if
		advance_token
		peek_token token_get_type IDENT ne if
			"Expected identifier" panic
		end

		"extern " prints
		peek_token token_get_value prints
		newline

		advance_token
		return
	end

	"SYNTAX ERROR: Expected fn or extern" panic
end

# void -> void (advances token_index & generates output)
fn generate_global_variable
	LET expect_token

	local name
	peek_token !name
	
	?name token_get_type IDENT ne if
		"Expected ident while generating global variable" panic
	end
	advance_token

	"section .data" prints newline

	local string_index

	peek_token token_get_type EQ eq if # With assignment
		advance_token
		peek_token token_get_type NUMBER eq if
			?name token_get_value prints
				" dq " prints
					peek_token token_get_value printu newline
			advance_token

			"section .text" prints newline
			return
		end
		peek_token token_get_type STRING eq if
			peek_token token_get_value create_string !string_index
			?name token_get_value prints
				" dq STRING" prints
					?string_index printu newline
			advance_token

			"section .text" prints newline
			return
		end

		"Expected number or string while generating global variable" panic
	else
		?name token_get_value prints
			" dq 0" prints newline
		"section .text" prints newline
		return
	end
end

fn generate_space
	SPACE expect_token

	peek_token token_get_type IDENT ne if
		"Expected ident while generating space" panic
	end

	"section .bss" prints newline
	peek_token token_get_value prints
		" resb " prints

	advance_token

	peek_token token_get_type NUMBER ne if
		"Expected number while generating space" panic
	end

	peek_token token_get_value printu newline

	advance_token

	"section .text" prints newline
end

space locals      4096  # That is 64 variables with 64 character long names
space locals_len  8


# Obs: This assumes a value is already in the stack
# void -> void (generate output)
fn generate_function_footer
	"mov rsp, rbp" prints newline
	"pop rbp"      prints newline
	"ret"          prints newline
end

# void -> void (advances token_index & generates output)
fn generate_function
	&locals_len 0 set

	FN expect_token

	local name
	peek_token !name

	?name token_get_type IDENT ne if
		"SYNTAX ERROR: Expected ident"
	end
	advance_token


	?name token_get_value prints
	":" prints newline

	"push rbp"     prints newline
	"mov rbp, rsp" prints newline

	LPAREN expect_token # TODO: Parameters

	local parameter_count 0 !parameter_count

	local parameter

	loop # Create the locals for the parameters
		peek_token token_get_type IDENT ne if
			break
		end
		peek_token !parameter

		?parameter token_get_value create_local
		advance_token

		?parameter_count 1 add !parameter_count

		peek_token token_get_type COMMA eq
			peek_token token_get_type RPAREN eq
				bor not if
					"Expected , or ) when parsing parameter list" panic
		end

		peek_token token_get_type COMMA eq if
			advance_token
		end
	end

	RPAREN expect_token

	local i 0 !i
	loop # Pops the stack into the locals
		?i ?parameter_count ge if
			break
		end

		"mov rax, qword[rcx]" prints newline

		"mov qword[rsp + 8*" prints
		?i printu
		"], rax" prints newline

		"add rcx, 8" prints newline

		?i 1 add !i
	end

	generate_block

	"sub rcx, 8" # Push a random value, all function must return a 64 bit value
	generate_function_footer
end

fn generate_block
	LBRACK expect_token

	local next_token
	loop
		peek_token !next_token
		?next_token token_get_type RBRACK eq if
			advance_token
			return
		end
		?next_token token_get_type SEMI eq if
			advance_token
			continue
		end
		generate_block_statement
	end
end

# char* (local name) -> void (generates output)
fn create_local local local_name
	!local_name

	local dst_pointer

	&locals_len get 64 ge if
		"Only 64 locals allowed" panic
	end

	&locals
		&locals_len get 64 mul
				add !dst_pointer

	?dst_pointer
		?local_name
			strcpy

	&locals_len
		&locals_len get 1 add
			set

	"sub rsp, 8" prints newline
end

# void -> void (advances token_index, changes locals & generates output)
fn generate_local
	LET expect_token

	peek_token token_get_type IDENT ne if
		"Expected identifier while parsing let" panic
	end

	peek_token token_get_value create_local

	peek_2_tokens swap pop token_get_type EQ eq if  # let x = ...
		"; Genarating assignment" prints newline
		generate_assignment
	else
		"; Just advancing" prints newline
		advance_token
	end
end

# void -> void (advances token_index, might change locals & generates output)
fn generate_block_statement
	local token
	local next_token
	peek_2_tokens !next_token !token

	?token token_get_type LET eq if
		generate_local
		return
	end
	?token token_get_type RETURN eq if
		advance_token
		generate_expression
		generate_function_footer
		return
	end
	?token token_get_type IF eq if
		generate_if_statement
		return
	end
	?token token_get_type LOOP eq if
		generate_loop
		return
	end
	?token token_get_type BREAK eq if
		generate_break
		return
	end
	?token token_get_type CONTINUE eq if
		generate_continue
		return
	end
	?token token_get_type IDENT eq
		?next_token token_get_type EQ eq
			band if
				generate_assignment
				return
	end

	generate_expression
	"add rcx, 8" prints newline     # All expressions push a 64 bit value, pop it
end

# void -> void (advances token_index & generates output)
fn generate_assignment
	local name
	local local_index
	peek_token !name

	?name token_get_type IDENT ne if
		"Expected ident while generating assignment" panic
	end

	advance_token
	EQ expect_token

	generate_expression

	?name token_get_value get_local_index_from_top !local_index

	?local_index -1 eq if # Local not found
		"mov rax, qword[rcx]" prints newline
		"mov qword[" prints
			?name token_get_value prints
				"], rax" prints newline
		"add rcx, 8" prints newline
	else
		"mov rax, qword[rcx]" prints newline
		"mov qword[rsp + 8*" prints
			?local_index printu
				"], rax" prints newline
		"add rcx, 8" prints newline
	end
end

space id 8

# void -> u64
fn new_id
	&id
		&id get 1 add
			set

	&id get return
end

# void -> void (advances token_index & generates output)
# Generates either if or elseif statements
fn generate_if_statement
	peek_token token_get_type IF eq
		peek_token token_get_type ELSEIF eq
			bor not if
				"Got" prints
				peek_token print_token
				"Expected if or elseif when parsing string" panic
	end
	advance_token

	local id
	new_id !id

	generate_expression

	"mov rax, qword[rcx]" prints newline
	"add rcx, 8"          prints newline
	"cmp rax, 0"          prints newline
	"je .if" prints
		?id printu
			"false" prints newline

	".if" prints
		?id printu
			"true:" prints newline

	generate_block

	"jmp .if" prints
		?id printu
			"end" prints newline

	".if" prints
		?id printu
			"false:" prints newline

	peek_token token_get_type ELSEIF eq if
		generate_if_statement
	else
		peek_token token_get_type ELSE eq if
			advance_token
			generate_block
		end
	end

	".if" prints
		?id printu
			"end:" prints newline
end

space current_loop_id 8

# void -> void (advances token_index & generates output)
fn generate_loop
	local id
	new_id !id

	local last_loop_id
	&current_loop_id get !last_loop_id

	&current_loop_id
		?id
			set

	LOOP expect_token

	".loop" prints
		?id printu
			"start:" prints newline

	generate_block

	"jmp .loop" prints
		?id printu
			"start" prints newline

	".loop" prints
		?id printu
			"end:" prints newline

	&current_loop_id
		?last_loop_id
			set
end

# void -> void (advances token_index & generates output)
fn generate_break
	BREAK expect_token
	local id
	&current_loop_id get !id

	"jmp .loop" prints
		?id printu
			"end" prints newline
end

# void -> void (advances token_index & generates output)
fn generate_continue
	CONTINUE expect_token
	local id
	&current_loop_id get !id

	"jmp .loop" prints
		?id printu
			"start" prints newline
end

# void -> void (advances token_index & generates output)
fn generate_expression
	generate_logical_expression
end

# void -> void (advances token_index & generates output)
fn generate_logical_expression
	local next_token

	generate_comparison
	loop
		peek_token !next_token

		?next_token token_get_type AND ne
			?next_token token_get_type OR ne
				band if   # is not an 'and' or an 'or'
					break
		end
		advance_token

		generate_comparison

		"mov rax, 0"              prints newline  # Cast into boolean (x = x!=0)
		"mov rdx, qword[rcx+8]"   prints newline
		"cmp rdx, 0"              prints newline
		"setne al"                prints newline

		"mov rbx, 0"              prints newline
		"mov rdx, qword[rcx]"     prints newline
		"cmp rdx, 0"              prints newline
		"setne bl"                prints newline

		?next_token token_get_type AND eq if    # Add top two elements of stack
			"and rax, rbx" prints newline
		end
		?next_token token_get_type OR eq if   # Subtract ''
			"or rax, rbx" prints newline
		end

		"add rcx, 8"            prints newline
		"mov qword[rcx], rax"   prints newline
	end
end

# void -> void (advances token_index & generates output)
fn generate_comparison
	local next_token

	generate_sum
	peek_token !next_token

	?next_token token_get_type LE ne
		?next_token token_get_type GE ne band
			?next_token token_get_type LT ne band
				?next_token token_get_type GT ne band
					?next_token token_get_type EQEQ ne band
						?next_token token_get_type NE ne band
							if
								return
	end
	advance_token

	generate_sum

	"mov rdx, 0"              prints newline
	"mov rax, qword[rcx+8]"   prints newline
	"mov rbx, qword[rcx]"     prints newline
	"cmp rax, rbx"            prints newline

	?next_token token_get_type LE eq if
		"setle dl" prints newline
	end
	?next_token token_get_type GE eq if
		"setge dl" prints newline
	end
	?next_token token_get_type LT eq if
		"setl dl" prints newline
	end
	?next_token token_get_type GT eq if
		"setg dl" prints newline
	end
	?next_token token_get_type EQEQ eq if
		"sete dl" prints newline
	end
	?next_token token_get_type NE eq if
		"setne dl" prints newline
	end
	"add rcx, 8"            prints newline
	"mov qword[rcx], rdx"   prints newline
end

# void -> void (advances token_index & generates output)
fn generate_sum
	local next_token

	generate_product
	loop
		peek_token !next_token

		?next_token token_get_type PLUS ne
			?next_token token_get_type MINUS ne
				band if   # is not a '+' or a '-'
					break
		end
		advance_token

		generate_product

		"mov rax, qword[rcx+8]"   prints newline

		?next_token token_get_type PLUS eq if    # Add top two elements of stack
			"add rax, qword[rcx]" prints newline
		end
		?next_token token_get_type MINUS eq if   # Subtract ''
			"sub rax, qword[rcx]" prints newline
		end

		"add rcx, 8"            prints newline
		"mov qword[rcx], rax"   prints newline
	end
end

# void -> void (advances token_index & generates output)
fn generate_product
	local next_token

	generate_unuary
	loop
		peek_token !next_token

		?next_token token_get_type MULT ne
			?next_token token_get_type DIVIDE ne band
				?next_token token_get_type MODULO ne band if
					break
		end
		advance_token

		generate_unuary

		"mov rax, qword[rcx+8]"   prints newline
		"mov rbx, qword[rcx]"     prints newline

		?next_token token_get_type MULT eq if
			"imul rbx"               prints newline
			"add  rcx, 8"            prints newline
			"mov  qword[rcx], rax"   prints newline
			return
		end

		"mov  rdx, 0" prints newline
		"idiv rbx"    prints newline

		?next_token token_get_type DIVIDE eq if
			"add  rcx, 8"            prints newline
			"mov  qword[rcx], rax"   prints newline
		end
		?next_token token_get_type MODULO eq if
			"add  rcx, 8"            prints newline
			"mov  qword[rcx], rdx"   prints newline
		end
	end
end

# void -> void (advances token_index & generates output)
fn generate_unuary
	peek_token token_get_type MULT eq if
		advance_token
		generate_primary

		"mov rax, qword[rcx]"   prints newline
		"mov rbx, qword[rax]"  prints newline
		"mov qword[rcx], rbx"   prints newline
	end
	peek_token token_get_type MINUS eq if
		advance_token
		generate_primary

		"mov rax, qword[rcx]"   prints newline
		"neg rax"               prints newline
		"mov qword[rcx], rax"   prints newline
	end
	generate_primary
end

# void -> void (advances token_index & generates output)
fn generate_argument_list
	LPAREN expect_token

	loop
		peek_token token_get_type RPAREN eq if
			advance_token
			return
		end

		generate_expression

		peek_token token_get_type COMMA eq
			peek_token token_get_type RPAREN eq
				bor not if
					"Expected , or )" panic
		end

		peek_token token_get_type COMMA eq if
			advance_token
		end
	end
end

# void -> void (advances token_index & generates output)
fn generate_function_call
	local name
	peek_token !name
	advance_token

	generate_argument_list

	"call " prints
	?name token_get_value prints newline
end

# void -> void (advances token_index & generates output)
fn generate_primary
	local token
	local next_token
	peek_2_tokens !next_token !token

	?token token_get_type STRING eq if
		generate_string
	end
	?token token_get_type NUMBER eq if
		"sub rcx, 8"         prints newline
		"mov qword[rcx], "   prints
		?token token_get_value printi
		newline
		advance_token
		return
	end

	local local_index
	?token token_get_type IDENT eq if
		?next_token token_get_type LPAREN eq if  # function call
			generate_function_call
			return
		end

		?token token_get_value get_local_index_from_top !local_index

		?local_index -1 eq if # No such local variable, assume a global
			"mov rax, qword[" prints
				?token token_get_value prints
					"]" prints newline
			"sub rcx, 8" prints newline
			"mov qword[rcx], rax" prints newline
		else
			"sub rcx, 8" prints newline
			"mov rax, qword[rsp + 8*" prints
				?local_index printu
					"]" prints newline
			"mov qword[rcx], rax" prints newline
		end
		advance_token
		return
	end
	?token token_get_type POINTER eq if
		?next_token token_get_type IDENT ne if
			"Expected ident when generating pointer" panic
		end
		?next_token token_get_value get_local_index_from_top !local_index

		?local_index -1 eq if
			"mov rax, " prints
				?next_token token_get_value prints newline
			"sub rcx, 8" prints newline
			"mov qword[rcx], rax" prints newline
		else
			"mov rax, rsp + 8*" prints
				?local_index printu newline
			"sub rcx, 8" prints newline
			"mov qword[rcx], rax" prints newline
		end

		advance_token
		advance_token
	end
	?token token_get_type LPAREN eq if
		advance_token
		generate_expression
		RPAREN expect_token
		return
	end
end

space strings 1048576 # 1024 strings, 1024 characters long
space strings_len 8

# u8 -> bool
fn is_printable local char
	!char

	?char '!' ge
		?char '~' le
			band if
				1 return
	end
	0 return
end

# void -> void (advances token_index, changes strings & generates output)
fn generate_string
	peek_token token_get_type STRING ne if
		"Expected a string" panic
	end

	local string_index

	peek_token token_get_value
		create_string
			!string_index

	"lea rax, STRING" prints
		?string_index printu newline
	"sub rcx, 8" prints newline
	"mov qword[rcx], rax" prints newline

	advance_token
end

# Receives a string to save and returns its index
# char* -> u64
fn create_string local str
	!str

	local dst_pointer

	&strings_len get 1024 ge if
		"Only 1024 strings allowed" panic
	end

	&strings
		&strings_len get 1024 mul
				add !dst_pointer

	?dst_pointer
		?str
			strcpy

	&strings_len
		&strings_len get 1 add
			set

	&strings_len get 1 sub return
end

# Returns -1 if not found
# char* -> u64
fn get_local_index_from_top local name
	!name

	local index
	local string_pointer

	&locals_len get 1 sub !index

	loop
		&locals
			?index 64 mul
					add !string_pointer

		?string_pointer ?name streq if
			&locals_len get ?index sub 1 sub return
		end

		?index 0 eq if
			-1 return
		end

		?index 1 sub !index
	end
end

fn main
	1024 1024 mul global_arena_allocator_start

	# Reading input
	&input
		0 read_all_to_string
			set
	&char_length
		&input get strlen
			set
	&char_index 0 set

	# Tokenization (1st pass)
	&tokens
		token_size list_new
			set

	consume_all_tokens

	# print_tokens

	# Parsing and generating (2nd pass)
	&token_index 0 set
	&strings_len 0 set

	generate_header
	generate_program
	generate_footer

	global_arena_allocator_end
end
