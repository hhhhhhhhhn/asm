extern printu
extern prints
extern printc
extern newline
extern dumplen
extern syscall4

let WIDTH = 200
let HEIGHT = 100
let FB_WIDTH = 1920
let FB_HEIGHT = 1080
space buffer 80000 # 4 bytes * 100 HEIGHT * 200 WIDTH
space black_buffer 10000
let buffer_len = 80000
let BLUE = 0x0000ff00

fn low_byte(x) {
	return band(x, 0xff);
}

fn write_pixel(x, y, color) {
	let location = &buffer + 4*(y*WIDTH + x);

	set_byte(location+0, low_byte(rshift(color, 3*8)));
	set_byte(location+1, low_byte(rshift(color, 2*8)));
	set_byte(location+2, low_byte(rshift(color, 1*8)));
	set_byte(location+3, low_byte(rshift(color, 0*8)));
}

fn read_pixel(x, y) {
	let location = &buffer + 4*(y*WIDTH + x);

	let r = get_byte(location+0);
	let g = get_byte(location+1);
	let b = get_byte(location+2);
	let a = get_byte(location+3);

	return lshift(r, 3*8) + lshift(g,2*8) + lshift(b,8) + a
}

